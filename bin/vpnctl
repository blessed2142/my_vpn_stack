#!/usr/bin/env bash
# vpnctl — управление пользователями и состоянием VPN-стека.
set -euo pipefail

VPNSTACK_DIR="${VPNSTACK_DIR:-/opt/vpnstack}"
. "$VPNSTACK_DIR/lib/common.sh"
. "$VPNSTACK_DIR/lib/render.sh"
. "$VPNSTACK_DIR/lib/links.sh"
. "$VPNSTACK_DIR/lib/cert.sh"
. "$VPNSTACK_DIR/lib/clients.sh"

require_root
detect_os
clients_init
state_load

usage() {
cat <<USAGE
vpnctl — управление VPN-стеком (VLESS REALITY + Hysteria2 + AmneziaWG)

  vpnctl add <имя> [--qr]     создать клиента во всех трёх протоколах
  vpnctl del <имя>            удалить клиента
  vpnctl list                 список клиентов
  vpnctl show <имя> [--qr]    ссылки/конфиги клиента
  vpnctl links [--qr]         ссылки всех клиентов
  vpnctl status               состояние сервисов и портов
  vpnctl regen                перегенерировать конфиги из состояния и перезапустить
  vpnctl restart              перезапустить все сервисы
  vpnctl tls-acme <домен> <email>   переключить Hysteria2 на Let's Encrypt
  vpnctl info                 параметры сервера (порты, SNI, ключи)
  vpnctl diag                 полная диагностика для разбора проблем
  vpnctl check-ports          доступны ли порты снаружи (кто виноват: хостер или клиент)
  vpnctl selftest             подключиться к своему же VLESS настоящим клиентом
  vpnctl fix-keys             привести ключи REALITY в соответствие друг другу
  vpnctl probe                перебрать маскировочные сайты и отпечатки TLS
  vpnctl set-fp <отпечаток>   сменить отпечаток TLS в ссылках
  vpnctl debug on|off|log     подробные логи Xray: доходят ли попытки подключения
  vpnctl firewall on|off|status   аварийно включить/выключить nftables
  vpnctl dns [домен]          куда сейчас указывает домен и совпадает ли с сервером
  vpnctl import-hysteria [файл]   забрать пользователей и пароль обфускации
                              из конфига Hysteria, настроенного вручную
USAGE
}

cmd_add() {
    local name="${1:-}"; shift || true
    [ -n "$name" ] || die "Укажите имя: vpnctl add <имя>"
    valid_name "$name" || die "Имя: латиница/цифры/._- до 32 символов."
    client_exists "$name" && die "Клиент '$name' уже существует."

    provision_client "$name"
    render_all; reload_all
    ok "Клиент '$name' создан."
    state_load
    show_client "$name" "${1:-}"
}

cmd_del() {
    local name="${1:-}"
    [ -n "$name" ] || die "Укажите имя: vpnctl del <имя>"
    client_exists "$name" || die "Клиент '$name' не найден."
    jq --arg n "$name" 'del(.clients[$n])' "$CLIENTS_FILE" | clients_write
    rm -rf "${STATE_DIR:?}/clients/$name"
    render_all; reload_all
    ok "Клиент '$name' удалён."
}

cmd_list() {
    printf '%-20s %-38s %-16s %s\n' "ИМЯ" "UUID (VLESS)" "AWG IP" "СОЗДАН"
    jq -r '.clients | to_entries[] |
        [.key, (.value.uuid // "-"), (.value.awg_ip4 // "-"), (.value.created // "-")] | @tsv' \
        "$CLIENTS_FILE" | while IFS=$'\t' read -r n u a c; do
        printf '%-20s %-38s %-16s %s\n' "$n" "$u" "$a" "$c"
    done
}

cmd_links() {
    local n
    for n in $(clients_names); do show_client "$n" "${1:-}"; done
}

cmd_status() {
    hdr "Сервисы"
    local s
    for s in xray hysteria-server "awg-quick@${AWG_IFACE:-awg0}"; do
        if svc_active "$s"; then printf '  %s%-28s активен%s\n' "$C_GRN" "$s" "$C_OFF"
        else printf '  %s%-28s НЕ активен%s\n' "$C_RED" "$s" "$C_OFF"; fi
    done
    hdr "Слушающие порты"
    ss -lntup 2>/dev/null | grep -E 'xray|hysteria|:'"${AWG_PORT:-51820}" || true
    if have awg && awg show "${AWG_IFACE:-awg0}" >/dev/null 2>&1; then
        hdr "AmneziaWG пиры"; awg show "${AWG_IFACE:-awg0}"
    fi
    hdr "Firewall"
    nft list table inet filter >/dev/null 2>&1 && echo "  nftables: правила загружены" || echo "  nftables: правил нет"
}

cmd_info() {
    hdr "Параметры сервера"
    cat <<INFO
  Точка подключения : ${ENDPOINT:-?}
  IPv4 / IPv6       : ${SERVER_IP4:-?} / ${SERVER_IP6:--}

  VLESS REALITY     : TCP ${VLESS_PORT:-443}
    SNI/dest        : ${REALITY_SNI:-?}
    public key      : ${REALITY_PUBLIC_KEY:-?}
    short id        : ${REALITY_SHORT_ID:-?}

  Hysteria2         : UDP ${HY2_PORT:-?}   TLS: ${HY2_TLS_MODE:-не под управлением vpnctl}   SNI: ${HY2_SNI:-?}
    управление      : $( [ "${HY2_MANAGED:-1}" = "1" ] && echo "vpnctl" || echo "ваше ручное (--keep-hysteria)" )
    obfs salamander : ${HY2_OBFS_PASS:+включена}${HY2_OBFS_PASS:-выключена}

  AmneziaWG         : UDP ${AWG_PORT:-?}   режим: $( [ "${AWG_USE_KERNEL:-0}" = 1 ] && echo ядро || echo userspace )
    сеть            : ${AWG_NET4_PREFIX:-?}.0/24 , ${AWG_NET6_PREFIX:-?}::/64
    server pubkey   : ${AWG_PUBLIC_KEY:-?}
    обфускация      : Jc=${AWG_JC:-?} Jmin=${AWG_JMIN:-?} Jmax=${AWG_JMAX:-?} S1=${AWG_S1:-?} S2=${AWG_S2:-?}
                      H1=${AWG_H1:-?} H2=${AWG_H2:-?} H3=${AWG_H3:-?} H4=${AWG_H4:-?}
INFO
}

cmd_tls_acme() {
    local d="${1:-}" e="${2:-}"
    [ -n "$d" ] && [ -n "$e" ] || die "Использование: vpnctl tls-acme <домен> <email>"
    domain_points_here "$d" "${SERVER_IP4}" \
        || die "A-записи $d ($(resolve_a "$d" | tr '\n' ' ')) не ведут на ${SERVER_IP4}."

    systemctl stop hysteria-server 2>/dev/null || true
    issue_certbot_cert "$d" "$e" || die "Сертификат получить не удалось."
    adopt_certbot_cert "$d" || die "Сертификат выпущен, но скопировать не вышло."

    state_set HY2_DOMAIN "$d"; state_set HY2_SNI "$d"; state_set ACME_EMAIL "$e"
    state_set HY2_CERT /etc/hysteria/cert.pem; state_set HY2_KEY /etc/hysteria/key.pem
    state_set HY2_TLS_MODE custom; state_set HY2_INSECURE 0

    render_hysteria; systemctl restart hysteria-server
    wait_service_ready hysteria-server udp "${HY2_PORT}" 25 \
        || die "Не запустилась. Диагностика: vpnctl diag"
    ok "Hysteria2 переведена на сертификат Let's Encrypt ($d)."
    if [ "${ENDPOINT:-}" = "${SERVER_IP4}" ]; then
        state_set ENDPOINT "$d"
        ok "Адрес подключения в ссылках переключён с ${SERVER_IP4} на ${d}."
    fi
    warn "Ссылки изменились — раздайте заново: vpnctl links"
}

# Аварийный выключатель: если правила отрезали сервер, чинить надо быстро.
cmd_import_hysteria() { # cmd_import_hysteria ФАЙЛ
    local f="${1:-}"
    if [ -z "$f" ]; then
        f=$(ls -1t /etc/hysteria/config.yaml.manual-* 2>/dev/null | head -n1)
        [ -n "$f" ] || die "Укажите файл: vpnctl import-hysteria /etc/hysteria/config.yaml.manual-<дата>"
        log "Беру самый свежий бэкап: $f"
    fi
    [ -s "$f" ] || die "Файл не найден: $f"
    [ "${HY2_MANAGED:-1}" = "1" ] || die "Hysteria в режиме --keep-hysteria, импортировать некуда."

    local obfs port users n pw added=0 updated=0
    obfs=$(hy2_parse_obfs "$f"); port=$(hy2_parse_port "$f"); users=$(hy2_parse_users "$f")

    hdr "Импорт из $f"
    [ -n "$port" ] && printf '  порт в старом конфиге : UDP/%s (сейчас UDP/%s)\n' "$port" "${HY2_PORT:-?}"
    [ -n "$users" ] || die "В файле нет блока auth.userpass — импортировать нечего."
    if [ -n "$obfs" ]; then
        echo "  пароль обфускации     : найден"
        state_set HY2_OBFS_PASS "$obfs"
    else
        echo "  пароль обфускации     : не найден (обфускация была выключена?)"
        state_set HY2_OBFS_PASS ""
    fi

    while IFS=$'\t' read -r n pw; do
        [ -n "$n" ] || continue
        valid_name "$n" || { warn "Пропускаю '$n': недопустимое имя."; continue; }
        client_exists "$n" && updated=$((updated + 1)) || added=$((added + 1))
        provision_client "$n" "$pw"
    done <<< "$users"

    state_load
    render_all; reload_all
    ok "Импортировано: новых ${added}, обновлено ${updated}."

    if [ -n "$port" ] && [ "$port" != "${HY2_PORT:-}" ]; then
        warn "Порт отличается: старый UDP/${port}, сейчас UDP/${HY2_PORT}."
        warn "Чтобы старые ссылки заработали полностью, переустановите с этим портом:"
        warn "  cd /opt/vpnstack && ./install.sh --only base,hysteria --hy2-port ${port}"
    else
        ok "Порт совпадает — старые ссылки Hysteria должны заработать как раньше."
    fi
    warn "Сертификат тоже должен совпасть: ссылки с insecure=1 не подойдут к Let's Encrypt и наоборот."
}

cmd_dns() {
    local d="${1:-${HY2_DOMAIN:-}}"
    [ -n "$d" ] || die "Укажите домен: vpnctl dns <домен>"
    hdr "DNS: $d"
    local ips; ips=$(resolve_a "$d")
    if [ -z "$ips" ]; then
        err "Домен не резолвится. Либо A-записи нет, либо на сервере сломан DNS."
        return 1
    fi
    printf '  A-записи      : %s\n' "$(printf '%s' "$ips" | tr '\n' ' ')"
    printf '  этот сервер   : %s\n' "${SERVER_IP4:-?}"
    if printf '%s\n' "$ips" | grep -qx "${SERVER_IP4:-нет}"; then
        ok "Совпадает — можно выдавать сертификат Let's Encrypt."
        if [ "${HY2_TLS_MODE:-}" = "selfsigned" ]; then
            warn "Сейчас стоит самоподписанный. Переключить: vpnctl tls-acme $d <email>"
        fi
    else
        warn "Не совпадает: домен ведёт на другой сервер, либо DNS ещё не разошёлся."
    fi
    return 0
}

# Доходят ли пакеты снаружи. Главный вопрос, когда сервер здоров, а клиенты
# не подключаются: ответ либо «блокирует хостер», либо «дело в клиенте».
cmd_check_ports() {
    hdr "Доступность портов снаружи"
    local p reach
    for p in "${VLESS_PORT:-443}" 80; do
        reach=$(timeout 25 curl -fsS --max-time 20 "https://ifconfig.co/port/${p}" 2>/dev/null \
                | jq -r '.reachable // empty' 2>/dev/null)
        case "$reach" in
            true)  printf '  tcp/%-6s %sдоступен снаружи%s\n' "$p" "$C_GRN" "$C_OFF" ;;
            false) printf '  tcp/%-6s %sЗАКРЫТ снаружи%s — блокирует хостер или внешний firewall\n' "$p" "$C_RED" "$C_OFF" ;;
            *)     printf '  tcp/%-6s проверить не вышло (сервис ifconfig.co недоступен)\n' "$p" ;;
        esac
    done
    cat <<'NOTE'

  UDP так не проверить — нет публичного сервиса. Проверьте с клиента:
    Linux/macOS : nc -vzu <адрес сервера> 443
    либо просто попробуйте подключиться и посмотрите vpnctl debug log

  Если tcp/443 закрыт снаружи, а Xray слушает — дело не в сервере:
  ищите firewall в панели хостера.
NOTE
}

# Временно включает подробные логи Xray, чтобы увидеть, доходят ли попытки
# подключения вообще. Если в логе пусто — пакеты до сервера не долетают.
cmd_debug() {
    case "${1:-}" in
        on)
            mkdir -p /var/log/xray
            chown nobody:nogroup /var/log/xray 2>/dev/null || chown nobody:nobody /var/log/xray 2>/dev/null || true
            state_set XRAY_DEBUG 1
            render_xray; systemctl restart xray
            ok "Подробные логи Xray включены."
            echo "  1) попробуйте подключиться с телефона"
            echo "  2) затем: vpnctl debug log"
            echo "  3) потом обязательно: vpnctl debug off" ;;
        off)
            state_set XRAY_DEBUG 0
            render_xray; systemctl restart xray
            ok "Подробные логи выключены." ;;
        log)
            local elog=/var/log/xray/error.log
            hdr "Xray: подключения"
            tail -n 40 /var/log/xray/access.log 2>/dev/null || echo "  лога нет — включите: vpnctl debug on"
            hdr "Xray: ошибки"
            tail -n 30 "$elog" 2>/dev/null || true
            hdr "Hysteria: последние события"
            journalctl -u hysteria-server -n 20 --no-pager 2>/dev/null \
                | grep -vE 'server up and running|server mode' || true

            hdr "Что это значит"
            if [ ! -s "$elog" ]; then
                echo "  Логов нет. Включите отладку (vpnctl debug on) и повторите попытку."
            elif grep -q 'failed to read client hello' "$elog"; then
                echo "  Найдено: REALITY ... failed to read client hello"
                echo
                echo "  Пакеты от клиента ДОХОДЯТ — сеть и firewall ни при чём."
                echo "  Но клиент не прислал TLS-приветствие: приложение не включило REALITY."
                echo "  Почти всегда это неполный импорт ссылки. Что делать:"
                echo "    1) импортировать по QR-коду, а не копированием текста:"
                echo "         vpnctl show <имя> --qr"
                echo "    2) проверить в приложении поля:"
                echo "         security/тип   = reality"
                echo "         publicKey/pbk  = ${REALITY_PUBLIC_KEY:-?}"
                echo "         shortId/sid    = ${REALITY_SHORT_ID:-?}"
                echo "         sni/serverName = ${REALITY_SNI:-?}"
                echo "         fingerprint    = chrome"
                echo "         flow           = xtls-rprx-vision"
                echo "    3) если полей REALITY в приложении нет — оно устарело, нужно другое"
                echo "       (v2rayNG, NekoBox, Hiddify, Streisand)."
            elif grep -qiE 'invalid user|not match|authentication failed' "$elog"; then
                echo "  Клиент дошёл до проверки, но не опознан: UUID в приложении не тот."
                echo "  Возьмите ссылку заново: vpnctl show <имя> --qr"
            elif grep -qiE 'accepted|connection' /var/log/xray/access.log 2>/dev/null; then
                echo "  Подключения проходят — на стороне VLESS всё в порядке."
            else
                echo "  Записей о попытках нет: пакеты до сервера не долетают."
                echo "  Проверьте внешний firewall хостера и vpnctl check-ports."
            fi ;;
        *) die "Использование: vpnctl debug on|off|log" ;;
    esac
}

# Поднимает на сервере настоящий клиент Xray и ходит через него наружу.
# Разводит: испорченные ключи, недоступный маскировочный сайт, мёртвый
# внешний канал, сломанный сетевой путь и проблему в приложении.
_TEST_URL="https://cp.cloudflare.com/generate_204"

_selftest_vless() { # _selftest_vless АДРЕС ПОДПИСЬ
    local addr="$1" label="$2" tmp pid code port=10809
    local name uuid
    name=$(clients_names | head -n1)
    uuid=$(client_get "$name" uuid)
    [ -n "$uuid" ] || { err "  ${label}: у клиента '$name' нет UUID"; return 1; }

    tmp=$(mktemp -d)
    jq -n --arg addr "$addr" --argjson vport "${VLESS_PORT:-443}" --argjson sport "$port" \
          --arg uuid "$uuid" --arg sni "${REALITY_SNI}" \
          --arg pbk "${REALITY_PUBLIC_KEY}" --arg sid "${REALITY_SHORT_ID}" '{
        log: { loglevel: "debug" },
        inbounds: [{ listen: "127.0.0.1", port: $sport, protocol: "socks",
                     settings: { udp: false } }],
        outbounds: [{
          protocol: "vless",
          settings: { vnext: [{ address: $addr, port: $vport,
                       users: [{ id: $uuid, encryption: "none", flow: "xtls-rprx-vision" }] }] },
          streamSettings: { network: "tcp", security: "reality",
            realitySettings: { serverName: $sni, fingerprint: "chrome",
                               publicKey: $pbk, shortId: $sid } }
        }]
      }' > "$tmp/client.json"

    xray run -c "$tmp/client.json" >"$tmp/log" 2>&1 &
    pid=$!
    sleep 2
    code=$(timeout 30 curl -s -o /dev/null -w '%{http_code}' \
           --proxy "socks5h://127.0.0.1:${port}" --max-time 25 "$_TEST_URL" 2>/dev/null) || code=""
    [ -n "$code" ] || code="000"
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true

    if [ "$code" = "204" ] || [ "$code" = "200" ]; then
        printf '  %s%s: трафик прошёл%s\n' "$C_GRN" "$label" "$C_OFF"
        rm -rf "$tmp"; return 0
    fi
    printf '  %s%s: не прошёл (HTTP %s)%s\n' "$C_RED" "$label" "$code" "$C_OFF"
    grep -iE 'reality|error|fail|reject|timeout|refused' "$tmp/log" 2>/dev/null \
        | tail -n 6 | sed 's/^/      /'
    rm -rf "$tmp"; return 1
}

cmd_selftest() {
    have xray || die "Xray не установлен."
    [ -n "${REALITY_PUBLIC_KEY:-}" ] || die "VLESS не настроен."

    # Сверяем не состояние с самим собой, а то, что раздаётся клиентам, с тем,
    # что реально использует запущенный сервер. Любое расхождение параметров
    # REALITY даёт один и тот же симптом: клиент виснет, сервер молчит.
    hdr "1. Параметры REALITY: ссылки против рабочего конфига"
    local cfg=/usr/local/etc/xray/config.json
    [ -s "$cfg" ] || die "Нет конфига ${cfg}"
    local c_priv c_sni c_sid derived bad=0
    c_priv=$(jq -r '.inbounds[0].streamSettings.realitySettings.privateKey // empty' "$cfg")
    c_sni=$(jq -r '.inbounds[0].streamSettings.realitySettings.serverNames[0] // empty' "$cfg")
    c_sid=$(jq -r '.inbounds[0].streamSettings.realitySettings.shortIds[0] // empty' "$cfg")

    derived=$(xray x25519 -i "$c_priv" 2>/dev/null \
              | grep -iE '^[[:space:]]*(public|password)' | head -n1 | sed 's/.*:[[:space:]]*//')
    if [ -z "$derived" ]; then
        warn "  публичный ключ из приватного вывести не удалось — проверку пропускаю"
    elif [ "$derived" = "${REALITY_PUBLIC_KEY}" ]; then
        ok "  публичный ключ соответствует приватному из конфига"
    else
        err "  КЛЮЧИ НЕ СОГЛАСОВАНЫ — клиенты не могут опознать сервер."
        echo "      раздаётся в ссылках : ${REALITY_PUBLIC_KEY}"
        echo "      нужен по конфигу    : ${derived}"
        bad=1
    fi
    if [ "$c_sni" = "${REALITY_SNI}" ]; then
        ok "  sni совпадает: ${c_sni}"
    else
        err "  SNI расходится: в ссылках '${REALITY_SNI}', в конфиге '${c_sni}'"; bad=1
    fi
    if [ "$c_sid" = "${REALITY_SHORT_ID}" ]; then
        ok "  shortId совпадает"
    else
        err "  shortId расходится: в ссылках '${REALITY_SHORT_ID}', в конфиге '${c_sid}'"; bad=1
    fi
    if [ "$bad" = 1 ]; then
        echo
        echo "      Починить:  vpnctl fix-keys   (затем раздать ссылки заново)"
        return 1
    fi

    hdr "2. Внешний канал сервера"
    local base
    base=$(timeout 20 curl -s -o /dev/null -w '%{http_code}' --max-time 15 "$_TEST_URL" 2>/dev/null) || base=""
    if [ "$base" = "204" ] || [ "$base" = "200" ]; then
        ok "  сервер сам ходит в интернет (HTTP ${base})"
    else
        err "  сервер НЕ может выйти в интернет (HTTP ${base:-000}) — сначала это."
        return 1
    fi

    hdr "3. Маскировочный сайт ${REALITY_SNI}"
    if timeout 15 openssl s_client -connect "${REALITY_SNI}:443" -servername "${REALITY_SNI}" \
         -alpn h2 -tls1_3 </dev/null 2>/dev/null | grep -q 'ALPN protocol: h2'; then
        ok "  доступен, отдаёт TLS 1.3 + h2"
    else
        err "  НЕдоступен или не отдаёт TLS1.3/h2 — REALITY работать не будет."
        echo "      Сменить: ./install.sh --only xray --reality-sni <другой домен>"
        return 1
    fi

    hdr "4. Подключение настоящим клиентом"
    local lo=0 ext=0
    _selftest_vless "127.0.0.1" "через loopback (только протокол)" && lo=1
    _selftest_vless "${ENDPOINT}" "через ${ENDPOINT} (протокол + сеть)" && ext=1

    hdr "Вывод"
    if [ "$lo" = 1 ] && [ "$ext" = 1 ]; then
        echo "  Сервер и сетевой путь исправны: настоящий клиент подключается."
        echo "  Значит дело в приложении на устройстве или в его сети."
    elif [ "$lo" = 1 ] && [ "$ext" = 0 ]; then
        echo "  Протокол работает, но через внешний адрес — нет."
        echo "  Трафик рвут по дороге: внешний firewall хостера или фильтрация."
    else
        echo "  Не работает даже через loopback."
        echo "  Ключи, канал и маскировочный сайт при этом в порядке — смотрите строки"
        echo "  лога выше и пришлите их; заодно: vpnctl debug on, повторить, vpnctl debug log."
    fi
}

# Перевыпускает пару ключей REALITY, если публичный в состоянии не соответствует
# приватному в конфиге. Все выданные ссылки после этого надо раздать заново.
cmd_fix_keys() {
    have xray || die "Xray не установлен."
    local derived
    derived=$(xray x25519 -i "${REALITY_PRIVATE_KEY}" 2>/dev/null \
              | grep -iE '^[[:space:]]*(public|password)' | head -n1 | sed 's/.*:[[:space:]]*//')
    if [ -n "$derived" ] && [ "$derived" != "${REALITY_PUBLIC_KEY}" ]; then
        state_set REALITY_PUBLIC_KEY "$derived"
        ok "Публичный ключ исправлен на соответствующий приватному."
    else
        log "Пара уже согласована — перевыпускаю целиком."
        local k priv pub
        k=$(xray x25519)
        priv=$(grep -iE '^[[:space:]]*private' <<<"$k" | head -n1 | sed 's/.*:[[:space:]]*//')
        pub=$(grep -iE '^[[:space:]]*(public|password)' <<<"$k" | head -n1 | sed 's/.*:[[:space:]]*//')
        [ -n "$priv" ] && [ -n "$pub" ] || die "Не смог разобрать вывод xray x25519."
        state_set REALITY_PRIVATE_KEY "$priv"; state_set REALITY_PUBLIC_KEY "$pub"
        ok "Пара ключей перевыпущена."
    fi
    state_load; render_xray; systemctl restart xray
    warn "Ссылки VLESS изменились — раздайте заново: vpnctl links --qr"
}

# Поднимает временную пару сервер+клиент REALITY на свободных портах и
# проверяет, проходит ли через неё трафик. Рабочий сервис при этом не трогается.
_probe_pair() { # _probe_pair МАСКИРОВОЧНЫЙ_ДОМЕН ОТПЕЧАТОК
    local dest="$1" fp="$2" tmp k priv pub sid uuid code
    local sport=18443 cport=18080
    k=$(xray x25519 2>/dev/null)
    priv=$(grep -iE '^[[:space:]]*private' <<<"$k" | head -n1 | sed 's/.*:[[:space:]]*//')
    pub=$(grep -iE '^[[:space:]]*(public|password)' <<<"$k" | head -n1 | sed 's/.*:[[:space:]]*//')
    sid=$(rand_hex 8); uuid=$(xray uuid)
    tmp=$(mktemp -d)

    jq -n --arg dest "${dest}:443" --arg sni "$dest" --arg priv "$priv" --arg sid "$sid" \
          --arg uuid "$uuid" --argjson port "$sport" '{
        log: { loglevel: "error" },
        inbounds: [{ listen: "127.0.0.1", port: $port, protocol: "vless",
          settings: { clients: [{ id: $uuid, flow: "xtls-rprx-vision" }], decryption: "none" },
          streamSettings: { network: "tcp", security: "reality",
            realitySettings: { show: false, dest: $dest, xver: 0, serverNames: [$sni],
                               privateKey: $priv, shortIds: [$sid] } } }],
        outbounds: [{ protocol: "freedom" }] }' > "$tmp/s.json"

    jq -n --arg sni "$dest" --arg fp "$fp" --arg pub "$pub" --arg sid "$sid" \
          --arg uuid "$uuid" --argjson sport "$sport" --argjson cport "$cport" '{
        log: { loglevel: "error" },
        inbounds: [{ listen: "127.0.0.1", port: $cport, protocol: "socks",
                     settings: { udp: false } }],
        outbounds: [{ protocol: "vless",
          settings: { vnext: [{ address: "127.0.0.1", port: $sport,
            users: [{ id: $uuid, encryption: "none", flow: "xtls-rprx-vision" }] }] },
          streamSettings: { network: "tcp", security: "reality",
            realitySettings: { serverName: $sni, fingerprint: $fp,
                               publicKey: $pub, shortId: $sid } } }] }' > "$tmp/c.json"

    xray run -c "$tmp/s.json" >"$tmp/s.log" 2>&1 & local sp=$!
    sleep 1
    xray run -c "$tmp/c.json" >"$tmp/c.log" 2>&1 & local cp=$!
    sleep 1
    code=$(timeout 25 curl -s -o /dev/null -w '%{http_code}' \
           --proxy "socks5h://127.0.0.1:${cport}" --max-time 18 "$_TEST_URL" 2>/dev/null) || code=""
    kill "$sp" "$cp" 2>/dev/null || true
    wait "$sp" "$cp" 2>/dev/null || true
    rm -rf "$tmp"
    [ "$code" = "204" ] || [ "$code" = "200" ]
}

# Перебирает маскировочные сайты и отпечатки, чтобы найти рабочее сочетание.
cmd_probe() {
    have xray || die "Xray не установлен."
    local d f ok_dest="" ok_fp=""
    local dests="${REALITY_SNI} www.cloudflare.com one.one.one.one www.yahoo.com
                 dl.google.com www.samsung.com www.lovelive-anime.jp"

    hdr "Перебор маскировочных сайтов (отпечаток chrome)"
    for d in $dests; do
        printf '  %-28s ' "$d"
        if _probe_pair "$d" chrome; then
            printf '%sработает%s\n' "$C_GRN" "$C_OFF"
            [ -z "$ok_dest" ] && ok_dest="$d"
        else
            printf '%sне работает%s\n' "$C_RED" "$C_OFF"
        fi
    done

    hdr "Перебор отпечатков на ${REALITY_SNI}"
    for f in chrome firefox safari ios edge random; do
        printf '  %-28s ' "$f"
        if _probe_pair "${REALITY_SNI}" "$f"; then
            printf '%sработает%s\n' "$C_GRN" "$C_OFF"
            [ -z "$ok_fp" ] && ok_fp="$f"
        else
            printf '%sне работает%s\n' "$C_RED" "$C_OFF"
        fi
    done

    hdr "Что делать"
    if [ -n "$ok_fp" ] && [ "$ok_fp" != "chrome" ]; then
        echo "  Текущий сайт годится, но с отпечатком '${ok_fp}':"
        echo "      vpnctl set-fp ${ok_fp}"
    elif [ -n "$ok_dest" ] && [ "$ok_dest" != "${REALITY_SNI}" ]; then
        echo "  Рабочий маскировочный сайт: ${ok_dest}"
        echo "      ./install.sh --only xray --reality-sni ${ok_dest}"
        echo "      vpnctl links --qr"
    elif [ -n "$ok_dest" ]; then
        echo "  Текущее сочетание работает — проблема не в REALITY."
    else
        echo "  Не сработало ни одно сочетание: REALITY на этом сервере не поднимается."
        echo "  Пришлите вывод, будем смотреть глубже."
    fi
}

# Отпечаток TLS влияет только на клиента и живёт в ссылке.
cmd_set_fp() {
    local f="${1:-}"
    case "$f" in
        chrome|firefox|safari|ios|android|edge|360|qq|random|randomized) ;;
        *) die "Отпечаток: chrome|firefox|safari|ios|android|edge|random" ;;
    esac
    state_set REALITY_FP "$f"
    ok "Отпечаток в ссылках: ${f}"
    warn "Ссылки VLESS изменились — раздайте заново: vpnctl links --qr"
}

cmd_firewall() {
    case "${1:-}" in
        off)
            nft flush ruleset 2>/dev/null || true
            systemctl stop nftables 2>/dev/null || true
            warn "Firewall выключен полностью — сервер открыт, включите обратно после разбора."
            ok "Вернуть: vpnctl firewall on" ;;
        on)
            [ -s /etc/nftables.conf ] || die "Нет /etc/nftables.conf — переустановите: ./install.sh --only base"
            nft -f /etc/nftables.conf || die "Правила не применились."
            systemctl start nftables 2>/dev/null || true
            ok "Firewall включён." ;;
        status|"")
            nft list ruleset 2>/dev/null | head -n 40 || echo "  правил нет" ;;
        *) die "Использование: vpnctl firewall on|off|status" ;;
    esac
}

# Полный срез состояния для разбора проблем. Секреты замаскированы.
cmd_diag() {
    hdr "Система"
    printf '  %s\n  ядро: %s  %s\n  дата: %s\n' \
        "$(. /etc/os-release; echo "$PRETTY_NAME")" "$(uname -r)" "$(uname -m)" "$(date -Is)"
    timedatectl 2>/dev/null | grep -Ei 'synchron|time zone' || true

    hdr "Версии"
    printf '  xray        : %s\n' "$(xray version 2>/dev/null | head -n1 || echo нет)"
    printf '  hysteria    : %s\n' "$(hysteria version 2>/dev/null | grep -i version | head -n1 || echo нет)"
    printf '  awg         : %s\n' "$(awg --version 2>/dev/null | head -n1 || echo нет)"
    printf '  amneziawg-go: %s\n' "$(command -v amneziawg-go || echo "нет (режим ядра)")"
    printf '  certbot     : %s\n' "$(certbot --version 2>/dev/null || echo нет)"

    hdr "Сервисы"
    local u
    for u in xray hysteria-server "awg-quick@${AWG_IFACE:-awg0}"; do
        printf '  %-24s %s / %s\n' "$u" \
            "$(systemctl is-active "$u" 2>/dev/null)" "$(systemctl is-enabled "$u" 2>/dev/null)"
    done

    hdr "Слушающие порты"
    ss -lntup 2>/dev/null | grep -vE '127\.0\.0\.1|\[::1\]' || true

    hdr "Сеть"
    printf '  resolv.conf (%s):\n' "$(readlink -f /etc/resolv.conf 2>/dev/null || echo '?')"
    grep -vE '^[[:space:]]*(#|$)' /etc/resolv.conf 2>/dev/null | sed 's/^/    /' | head -n 8 \
        || echo "    (пусто — резолверов нет)"
    printf '  systemd-resolved: %s\n' "$(systemctl is-active systemd-resolved 2>/dev/null)"
    if have resolvectl; then
        resolvectl status 2>/dev/null | grep -E 'Current DNS|DNS Servers|Fallback|Link [0-9]' | sed 's/^/    /' | head -n 10 || true
    fi
    printf '  маршрут v4: %s\n' "$(ip -4 route show default 2>/dev/null | head -n1)"
    printf '  маршрут v6: %s\n' "$(ip -6 route show default 2>/dev/null | head -n1)"
    printf '  accept_ra : all=%s default=%s | forwarding v6=%s\n' \
        "$(sysctl -n net.ipv6.conf.all.accept_ra 2>/dev/null)" \
        "$(sysctl -n net.ipv6.conf.default.accept_ra 2>/dev/null)" \
        "$(sysctl -n net.ipv6.conf.all.forwarding 2>/dev/null)"
    if timeout 6 ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; then
        echo "  ping 1.1.1.1      : ок"
    else
        echo "  ping 1.1.1.1      : НЕТ (маршрутизация или firewall)"
    fi
    if getent hosts github.com >/dev/null 2>&1; then
        echo "  резолвинг имён    : ок"
    else
        echo "  резолвинг имён    : СЛОМАН"
    fi

    hdr "Состояние (секреты скрыты)"
    sed -E "s/^(REALITY_PRIVATE_KEY|AWG_PRIVATE_KEY|HY2_OBFS_PASS)=.*/\1='***'/" \
        "$STATE_FILE" 2>/dev/null || echo "  нет $STATE_FILE"
    printf '  клиентов: %s\n' "$(jq -r '.clients|length' "$CLIENTS_FILE" 2>/dev/null || echo 0)"

    hdr "Xray: проверка конфига"
    xray run -test -config /usr/local/etc/xray/config.json 2>&1 | tail -n 5 || true

    hdr "Xray: локальное TLS-рукопожатие на свой же порт"
    printf '  (должен ответить сертификат %s — значит REALITY маскируется верно)\n' "${REALITY_SNI:-?}"
    timeout 15 openssl s_client -connect "127.0.0.1:${VLESS_PORT:-443}" \
        -servername "${REALITY_SNI:-www.microsoft.com}" </dev/null 2>/dev/null \
        | grep -E '^(subject|issuer|Verify return code)|Protocol|Cipher' | head -n 6 \
        || echo "  рукопожатие НЕ прошло"

    hdr "Xray: доступен ли маскировочный сайт с сервера"
    timeout 15 openssl s_client -connect "${REALITY_SNI:-www.microsoft.com}:443" \
        -servername "${REALITY_SNI:-www.microsoft.com}" -alpn h2 -tls1_3 </dev/null 2>/dev/null \
        | grep -E 'ALPN|Protocol|Verify return code' | head -n 4 \
        || echo "  маскировочный сайт НЕДОСТУПЕН с сервера — REALITY работать не будет"

    hdr "Hysteria: конфиг (пароли скрыты)"
    sed -E 's/(password|: )[^ ]{8,}/\1***/' /etc/hysteria/config.yaml 2>/dev/null | head -n 30 \
        || echo "  нет конфига"

    hdr "nftables: входящая цепочка"
    nft list chain inet filter input 2>/dev/null || echo "  правил нет"

    hdr "Журналы"
    for u in xray hysteria-server "awg-quick@${AWG_IFACE:-awg0}"; do
        printf '\n--- %s ---\n' "$u"
        journalctl -u "$u" -n 20 --no-pager 2>/dev/null || true
    done

    hdr "DNS"
    [ -n "${HY2_DOMAIN:-}" ] && cmd_dns "$HY2_DOMAIN" || echo "  домен не задан"

    hdr "Готово"
    echo "  Пришлите весь вывод выше — секреты в нём уже замаскированы."
}

case "${1:-}" in
    add)     shift; cmd_add "$@" ;;
    del|rm)  shift; cmd_del "$@" ;;
    list|ls) cmd_list ;;
    show)    shift; name="${1:-}"; shift || true; show_client "$name" "${1:-}" ;;
    links)   shift || true; cmd_links "${1:-}" ;;
    status)  cmd_status ;;
    info)    cmd_info ;;
    dns)     shift; cmd_dns "${1:-}" ;;
    import-hysteria) shift; cmd_import_hysteria "${1:-}" ;;
    regen)   render_all; reload_all; ok "Конфиги перегенерированы." ;;
    restart) systemctl restart xray hysteria-server "awg-quick@${AWG_IFACE:-awg0}"; ok "Перезапущено." ;;
    tls-acme) shift; cmd_tls_acme "$@" ;;
    diag)    cmd_diag ;;
    firewall) shift; cmd_firewall "${1:-}" ;;
    check-ports) cmd_check_ports ;;
    selftest) cmd_selftest ;;
    fix-keys) cmd_fix_keys ;;
    probe)   cmd_probe ;;
    set-fp)  shift; cmd_set_fp "${1:-}" ;;
    debug)   shift; cmd_debug "${1:-}" ;;
    ""|-h|--help|help) usage ;;
    *) err "Неизвестная команда: $1"; usage; exit 1 ;;
esac
